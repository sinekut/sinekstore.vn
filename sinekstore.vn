<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sinek Store - Dịch Vụ Game Giá Rẻ</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, sans-serif; }
        
        body { 
            background: linear-gradient(135deg, #020617 0%, #090d1f 50%, #0f172a 100%);
            color: #f8fafc; 
            padding-bottom: 70px; 
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        /* TẠO LỚP SAO LI TI LẤP LÁNH NỀN BẦU TRỜI ĐÊM */
        .star-field {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
            background-image: 
                radial-gradient(2px 2px at 20px 30px, #ffffff, rgba(0,0,0,0)),
                radial-gradient(2px 2px at 40px 70px, #38bdf8, rgba(0,0,0,0)),
                radial-gradient(1px 1px at 90px 40px, #ffffff, rgba(0,0,0,0)),
                radial-gradient(2px 2px at 160px 120px, #bae6fd, rgba(0,0,0,0)),
                radial-gradient(1px 1px at 230px 200px, #ffffff, rgba(0,0,0,0)),
                radial-gradient(2px 2px at 300px 80px, #38bdf8, rgba(0,0,0,0)),
                radial-gradient(1px 1px at 380px 250px, #ffffff, rgba(0,0,0,0));
            background-repeat: repeat;
            background-size: 400px 400px;
            opacity: 0.6;
            animation: twinkleStars 5s infinite alternate;
        }

        @keyframes twinkleStars {
            0% { opacity: 0.4; }
            100% { opacity: 0.8; }
        }

        /* TẠO HIỆU ỨNG SAO BĂNG VÚT QUA */
        .shooting-star {
            position: fixed;
            height: 2px;
            background: linear-gradient(90deg, rgba(255,255,255,1), rgba(56,189,248,0.8), transparent);
            border-radius: 999px;
            filter: drop-shadow(0 0 6px #38bdf8);
            z-index: 1;
            pointer-events: none;
            opacity: 0;
            animation: shootingStarAnim linear infinite;
        }

        @keyframes shootingStarAnim {
            0% {
                transform: rotate(315deg) translateX(0);
                opacity: 1;
            }
            100% {
                transform: rotate(315deg) translateX(-1000px);
                opacity: 0;
            }
        }
        
        @keyframes glowingBorder {
            0% { border-color: #0284c7; box-shadow: 0 0 5px rgba(2, 132, 199, 0.5); }
            50% { border-color: #38bdf8; box-shadow: 0 0 20px rgba(56, 189, 248, 0.8); }
            100% { border-color: #0284c7; box-shadow: 0 0 5px rgba(2, 132, 199, 0.5); }
        }

        @keyframes goldFlameAura {
            0% { border-color: #fbbf24; box-shadow: 0 0 8px #fbbf24, inset 0 0 5px #fbbf24; }
            50% { border-color: #f59e0b; box-shadow: 0 0 22px #f59e0b, 0 0 35px rgba(251, 191, 36, 0.6), inset 0 0 10px #fbbf24; }
            100% { border-color: #fbbf24; box-shadow: 0 0 8px #fbbf24, inset 0 0 5px #fbbf24; }
        }

        @keyframes shineText {
            0% { color: #38bdf8; text-shadow: 0 0 5px rgba(56,189,248,0.5); }
            50% { color: #fbbf24; text-shadow: 0 0 12px rgba(251,191,36,0.8); }
            100% { color: #38bdf8; text-shadow: 0 0 5px rgba(56,189,248,0.5); }
        }

        .header { display: flex; justify-content: space-between; align-items: center; padding: 12px 15px; background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(8px); border-bottom: 2px solid #0284c7; position: sticky; top: 0; z-index: 100; animation: glowingBorder 4s infinite; }
        
        .admin-contact-box { display: flex; align-items: center; gap: 8px; background: rgba(30, 41, 59, 0.9); padding: 4px 10px 4px 4px; border-radius: 30px; border: 2px solid #fbbf24; cursor: pointer; text-decoration: none; transition: 0.3s; animation: goldFlameAura 2s infinite ease-in-out; margin-top: 4px; z-index: 10; position: relative; }
        .admin-contact-box:hover { background: #334155; transform: scale(1.05); }
        
        .admin-avatar { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; border: 2px solid #fbbf24; display: block; }
        
        .admin-info { display: flex; flex-direction: column; }
        .admin-label { font-size: 9px; color: #94a3b8; text-transform: uppercase; font-weight: bold; }
        .admin-name { font-size: 11px; font-weight: bold; animation: shineText 3s infinite; }

        .user-panel { display: flex; align-items: center; gap: 8px; z-index: 10; position: relative; }
        .balance-badge { background: rgba(30, 41, 59, 0.9); color: #38bdf8; padding: 6px 10px; border-radius: 20px; font-size: 12px; border: 1px solid #334155; font-weight: bold; }
        .auth-btn { background: #0284c7; color: #fff; border: none; padding: 6px 10px; border-radius: 6px; font-size: 11px; font-weight: bold; cursor: pointer; transition: 0.2s; }
        .auth-btn:hover { background: #38bdf8; color: #0f172a; }

        .container { max-width: 800px; margin: 0 auto; padding: 15px; position: relative; z-index: 10; }
        .section-title { font-size: 16px; margin: 15px 0; color: #f1f5f9; text-transform: uppercase; border-left: 4px solid #38bdf8; padding-left: 8px; text-shadow: 0 2px 4px rgba(0,0,0,0.4); }
        .grid-container { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
        
        .card { background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(6px); border: 1px solid #334155; border-radius: 12px; padding: 14px; text-align: center; transition: 0.3s; box-shadow: 0 4px 15px rgba(0,0,0,0.3); }
        .card:hover { border-color: #38bdf8; box-shadow: 0 0 15px rgba(56,189,248,0.3); transform: translateY(-2px); }
        .card-icon { font-size: 32px; margin-bottom: 8px; }
        .card-title { font-size: 14px; font-weight: bold; margin-bottom: 6px; color: #f8fafc; }
        .card-desc { font-size: 12px; color: #94a3b8; margin-bottom: 10px; }
        .action-btn { width: 100%; background: #0284c7; color: #fff; border: none; padding: 8px; border-radius: 6px; font-size: 12px; font-weight: bold; cursor: pointer; transition: 0.2s; }
        .action-btn:hover { background: #38bdf8; color: #0f172a; }

        .bottom-nav { position: fixed; bottom: 0; left: 0; width: 100%; background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(8px); border-top: 1px solid #334151; display: flex; justify-content: space-around; padding: 10px 0; z-index: 100; box-shadow: 0 -4px 15px rgba(0,0,0,0.4); }
        .nav-item { color: #94a3b8; font-size: 11px; text-align: center; cursor: pointer; text-decoration: none; flex: 1; transition: 0.2s; }
        .nav-item.active { color: #38bdf8; font-weight: bold; text-shadow: 0 0 8px rgba(56,189,248,0.5); }

        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(2, 6, 23, 0.85); backdrop-filter: blur(5px); align-items: center; justify-content: center; z-index: 2000; padding: 15px; }
        .modal-content { background: #0f172a; border: 1px solid #0284c7; border-radius: 14px; width: 100%; max-width: 380px; padding: 20px; box-shadow: 0 0 25px rgba(2, 132, 199, 0.4); }
        .modal-title-custom { font-size: 18px; font-weight: bold; color: #38bdf8; margin-bottom: 15px; text-align: center; text-transform: uppercase; letter-spacing: 1px; }
        .form-group { margin-bottom: 12px; }
        .form-group label { display: block; font-size: 12px; color: #94a3b8; margin-bottom: 4px; }
        .form-control { width: 100%; background: #1e293b; border: 1px solid #334155; padding: 10px; border-radius: 6px; color: #fff; font-size: 13px; outline: none; }
        .form-control:focus { border-color: #38bdf8; box-shadow: 0 0 8px rgba(56,189,248,0.3); }
        .modal-buttons { display: flex; gap: 10px; margin-top: 15px; }
        .btn-close { background: #334151; color: #94a3b8; flex: 1; padding: 10px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; }
        .btn-submit { background: #0284c7; color: #fff; flex: 1; padding: 10px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; }
        
        .popup-box { background: #0f172a; border: 2px solid #0284c7; border-radius: 14px; width: 90%; max-width: 380px; padding: 22px; text-align: center; box-shadow: 0 0 30px rgba(2, 132, 199, 0.5); position: relative; }
        .popup-header { font-size: 18px; font-weight: bold; color: #38bdf8; margin-bottom: 18px; letter-spacing: 1px; text-transform: uppercase; }
        .popup-body { font-size: 13px; color: #e2e8f0; line-height: 1.6; margin-bottom: 20px; text-align: left; }
        .popup-btn { width: 100%; background: linear-gradient(to right, #0284c7, #38bdf8); color: #0f172a; border: none; padding: 12px; border-radius: 8px; font-weight: bold; font-size: 14px; cursor: pointer; text-transform: uppercase; box-shadow: 0 4px 12px rgba(2, 132, 199, 0.4); }

        .qr-img { width: 190px; height: 190px; display: block; margin: 10px auto; border-radius: 8px; border: 2px solid #38bdf8; }
        .note-box { background: #1e293b; padding: 10px; border-radius: 6px; font-size: 13px; color: #fbbf24; text-align: center; margin-bottom: 10px; font-weight: bold; border: 1px solid #334155; }
    </style>
</head>
<body>
    <!-- Lớp nền hiển thị bầu trời sao li ti -->
    <div class="star-field"></div>

    <!-- POPUP THÔNG BÁO -->
    <div class="modal" id="popupNotice" style="display: flex;">
        <div class="popup-box">
            <div class="popup-header">THÔNG BÁO</div>
            <div class="popup-body">
                • Khi nạp tiền qua QR ZaloPay, quý khách nhớ ghi <b>Đúng Nội Dung chuyển khoản</b> (VD: <i>NAP_tên_tài_khoản</i>).<br><br>
                • Nếu admin bận hoặc phản hồi chậm, vui lòng liên hệ các <b>Cộng Tác Viên (CTV)</b> để được hỗ trợ nhanh chóng!
            </div>
            <button class="popup-btn" onclick="dongPopupNotice()">ĐÓNG</button>
        </div>
    </div>

    <!-- MODAL MENU LỰA CHỌN KÊNH LIÊN HỆ ADMIN -->
    <div class="modal" id="modalContactAdmin">
        <div class="modal-content" style="text-align: center;">
            <div class="modal-title-custom">Chọn Kênh Liên Hệ</div>
            <p style="font-size: 12px; color: #94a3b8; margin-bottom: 15px;">Vui lòng chọn phương thức bạn muốn liên hệ với Admin:</p>
            <div style="display: flex; flex-direction: column; gap: 10px;">
                <button class="action-btn" style="background: #0284c7; padding: 12px; font-size: 14px;" onclick="lienHeZalo()">💬 Liên Hệ Qua Zalo</button>
                <button class="action-btn" style="background: #2563eb; padding: 12px; font-size: 14px;" onclick="lienHeFB()">🌐 Liên Hệ Qua Facebook</button>
            </div>
            <button class="btn-close" style="width: 100%; margin-top: 15px;" onclick="dongModal('modalContactAdmin')">Đóng</button>
        </div>
    </div>

    <!-- HEADER -->
    <div class="header">
        <div class="admin-contact-box" onclick="moMenuLienHe()">
            <div class="admin-avatar-wrapper" style="position:relative; width:34px; height:34px;">
                <img src="https://i.ibb.co/6V8qTFz/FB-IMG-1791121966996.jpg" alt="Admin Avatar" class="admin-avatar">
            </div>
            <div class="admin-info">
                <span class="admin-label">Liên Hệ</span>
                <span class="admin-name">Admin Shop</span>
            </div>
        </div>

        <div class="user-panel">
            <div class="balance-badge" id="displayBalance">0 đ</div>
            <button class="auth-btn" id="authBtn" onclick="moModalAuth()">Đăng Nhập</button>
        </div>
    </div>

    <!-- MAIN CONTAINER -->
    <div class="container">
        <!-- TRANG CHỦ: DANH MỤC -->
        <div id="pageHome" class="page-view">
            <div class="section-title">Danh Mục King Legacy</div>
            <div class="grid-container">
                <div class="card" onclick="moDanhMuc('caythue')">
                    <div class="card-icon">👑</div>
                    <div class="card-title">Cày Thuê King Legacy</div>
                    <div class="card-desc">Cày level, quái, sea king fin...</div>
                    <button class="action-btn">Xem Sản Phẩm</button>
                </div>
                <div class="card" onclick="moDanhMuc('itemnguyenlieu')">
                    <div class="card-icon">💎</div>
                    <div class="card-title">Item & Nguyên Liệu</div>
                    <div class="card-desc">Kiếm, phụ kiện, nguyên liệu hiếm</div>
                    <button class="action-btn">Xem Sản Phẩm</button>
                </div>
            </div>
        </div>

        <!-- TẦNG 2: DANH SÁCH SẢN PHẨM -->
        <div id="pageProducts" class="page-view" style="display: none;">
            <button onclick="veTrangChu()" style="background:#1e293b; color:#38bdf8; border:1px solid #334155; padding:6px 12px; border-radius:6px; cursor:pointer; margin-bottom:15px; font-weight:bold;">← Quay lại danh mục</button>
            <div class="section-title" id="categoryTitle">Sản Phẩm</div>
            <div class="grid-container" id="productList"></div>
        </div>

        <!-- TRANG NẠP TIỀN -->
        <div id="pageDeposit" class="page-view" style="display: none;">
            <div class="section-title">Nạp Tiền Vào Tài Khoản</div>
            <div style="background:rgba(15, 23, 42, 0.85); backdrop-filter: blur(6px); border:1px solid #334155; padding:15px; border-radius:10px; margin-bottom:15px; text-align:center;">
                <h3 style="font-size:14px; color:#38bdf8; margin-bottom:10px; text-align:left;">1. Nạp qua ZaloPay</h3>
                <p style="font-size:12px; color:#94a3b8; margin-bottom:10px; text-align:left;">Quét mã QR ZaloPay bên dưới và <b>nhập đúng nội dung chuyển khoản</b>:</p>
                
                <div class="note-box" id="bankSyntaxContent">Nội dung chuyển khoản: NAP_sinekut</div>
                
                <img src="https://i.ibb.co/tPsgyfKT/IMG-20261004-214345.jpg" alt="QR ZaloPay" class="qr-img">

                <div style="font-size:11px; color:#38bdf8; margin-top:10px; line-height: 1.4;">
                    ℹ️ Lưu ý: Sau khi nạp tiền, tiền sẽ được cộng vào tài khoản sau 1-12h. Nếu quá 12h chưa được cộng, vui lòng liên hệ Admin!
                </div>
            </div>

            <div style="background:rgba(15, 23, 42, 0.85); backdrop-filter: blur(6px); border:1px solid #334155; padding:15px; border-radius:10px;">
                <h3 style="font-size:14px; color:#38bdf8; margin-bottom:10px;">2. Nạp qua Thẻ Cào</h3>
                <div class="form-group">
                    <label>Chọn nhà mạng:</label>
                    <select id="cardType" class="form-control">
                        <option value="Viettel (CK: 25%)">Viettel (CK: 25%)</option>
                        <option value="Vinaphone (CK: 22%)">Vinaphone (CK: 22%)</option>
                        <option value="Mobifone (CK: 28%)">Mobifone (CK: 28%)</option>
                        <option value="Zing (CK: 22%)">Zing (CK: 22%)</option>
                        <option value="Vcoin (CK: 27%)">Vcoin (CK: 27%)</option>
                        <option value="Gate (CK: 28%)">Gate (CK: 28%)</option>
                        <option value="Scoin (CK: 30%)">Scoin (CK: 30%)</option>
                        <option value="Garena (CK: 25%)">Garena (CK: 25%)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Chọn mệnh giá:</label>
                    <select id="cardAmount" class="form-control">
                        <option value="10000">10.000 đ</option>
                        <option value="20000">20.000 đ</option>
                        <option value="50000">50.000 đ</option>
                        <option value="100000">100.000 đ</option>
                        <option value="200000">200.000 đ</option>
                        <option value="500000">500.000 đ</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Số Seri:</label>
                    <input type="text" id="cardSeri" class="form-control" placeholder="Nhập số seri thẻ">
                </div>
                <div class="form-group">
                    <label>Mã Thẻ (Mã nạp):</label>
                    <input type="text" id="cardPin" class="form-control" placeholder="Nhập mã thẻ cào">
                </div>
                <div style="font-size:11px; color:#f87171; margin-bottom:12px;">⚠️ Cảnh báo: Nhớ nhập đúng loại thẻ và mệnh giá. Sai mất tiền shop không chịu trách nhiệm!</div>
                
                <div style="display: flex; gap: 8px;">
                    <button class="action-btn" style="background:#0284c7;" onclick="guiTheCaoZalo()">Gửi Thẻ Qua Zalo</button>
                    <button class="action-btn" style="background:#2563eb;" onclick="guiTheCaoFB()">Gửi Thẻ Qua FB</button>
                </div>
            </div>
        </div>

        <!-- TRANG LỊCH SỬ MUA HÀNG -->
        <div id="pageHistory" class="page-view" style="display: none;">
            <div class="section-title">Lịch Sử Đặt Đơn</div>
            <div id="historyList" style="font-size:12px; color:#94a3b8; text-align:center; padding:20px;">Chưa có đơn hàng nào.</div>
        </div>

        <!-- TRANG ADMIN (QUẢN TRỊ VIÊN) -->
        <div id="pageAdmin" class="page-view" style="display: none;">
            <div class="section-title" style="border-color:#f87171;">Khu Vực Quản Trị Viên (Admin)</div>
            <div id="adminLoginBox" style="background:rgba(15, 23, 42, 0.85); border:1px solid #334155; padding:15px; border-radius:10px;">
                <div class="form-group">
                    <label>Mật khẩu QTV:</label>
                    <input type="password" id="adminPassInput" class="form-control" placeholder="Nhập mật khẩu quản trị">
                </div>
                <button class="action-btn" style="background:#f87171;" onclick="kiemTraAdmin()">Đăng Nhập QTV</button>
            </div>
            <div id="adminPanelBox" style="display:none; background:rgba(15, 23, 42, 0.85); border:1px solid #334155; padding:15px; border-radius:10px; margin-top:10px;">
                <h3 style="font-size:14px; color:#38bdf8; margin-bottom:10px;">Nạp Tiền Thủ Công Cho Khách</h3>
                <div class="form-group">
                    <label>Tên tài khoản khách:</label>
                    <input type="text" id="adUserTarget" class="form-control" placeholder="Nhập username khách">
                </div>
                <div class="form-group">
                    <label>Số tiền muốn nạp (VNĐ):</label>
                    <input type="number" id="adAmountTarget" class="form-control" placeholder="Ví dụ: 50000">
                </div>
                <button class="action-btn" onclick="adminNapTien()">Cộng Tiền Cho Khách</button>
            </div>
        </div>
    </div>

    <!-- BOTTOM NAVIGATION -->
    <div class="bottom-nav">
        <div class="nav-item active" onclick="chuyenTab('home', this)">🏠 Trang Chủ</div>
        <div class="nav-item" onclick="chuyenTab('deposit', this)">💳 Nạp Tiền</div>
        <div class="nav-item" onclick="chuyenTab('history', this)">📜 Lịch Sử</div>
        <div class="nav-item" onclick="chuyenTab('admin', this)">🛡 QTV</div>
        <div class="nav-item" onclick="chuyenTrangCTV()" style="color: #fbbf24; font-weight: bold;">🤝 CTV</div>
    </div>

    <!-- MODAL ĐẶT ĐƠN: CÀY THUÊ -->
    <div class="modal" id="modalCayThue">
        <div class="modal-content">
            <div class="modal-title-custom">Đặt Đơn Cày Thuê</div>
            <div class="form-group">
                <label>Sản phẩm:</label>
                <input type="text" id="ctProductName" class="form-control" readonly>
            </div>
            <div class="form-group">
                <label>Giá tiền:</label>
                <input type="text" id="ctProductPrice" class="form-control" readonly>
            </div>
            <div class="form-group">
                <label>Tài khoản game (Tên acc):</label>
                <input type="text" id="ctGameUser" class="form-control" placeholder="Nhập tên đăng nhập game">
            </div>
            <div class="form-group">
                <label>Mật khẩu game (Mk acc):</label>
                <input type="password" id="ctGamePass" class="form-control" placeholder="Nhập mật khẩu game">
            </div>
            <div class="form-group">
                <label>Ghi chú thêm (nếu có):</label>
                <input type="text" id="ctNote" class="form-control" placeholder="Ví dụ: Cày vào ban đêm...">
            </div>
            <div class="form-group">
                <label>Số điện thoại liên hệ:</label>
                <input type="text" id="ctPhone" class="form-control" placeholder="Nhập số điện thoại">
            </div>
            <div class="modal-buttons">
                <button class="btn-close" onclick="dongModal('modalCayThue')">Hủy</button>
                <button class="btn-submit" onclick="xacNhanThanhToanCayThue()">Xác Nhận & Gửi Zalo</button>
            </div>
        </div>
    </div>

    <!-- MODAL ĐẶT ĐƠN: ITEM & NGUYÊN LIỆU -->
    <div class="modal" id="modalItem">
        <div class="modal-content">
            <div class="modal-title-custom">Đặt Đơn Mua Item</div>
            <div class="form-group">
                <label>Sản phẩm:</label>
                <input type="text" id="itProductName" class="form-control" readonly>
            </div>
            <div class="form-group">
                <label>Giá tiền:</label>
                <input type="text" id="itProductPrice" class="form-control" readonly>
            </div>
            <div class="form-group">
                <label>Tên đăng nhập Roblox:</label>
                <input type="text" id="itGameUser" class="form-control" placeholder="Nhập đúng tên đăng nhập Roblox">
            </div>
            <div class="form-group">
                <label>Số điện thoại liên hệ:</label>
                <input type="text" id="itPhone" class="form-control" placeholder="Nhập số điện thoại">
            </div>
            <div class="modal-buttons">
                <button class="btn-close" onclick="dongModal('modalItem')">Hủy</button>
                <button class="btn-submit" onclick="xacNhanThanhToanItem()">Xác Nhận & Gửi Zalo</button>
            </div>
        </div>
    </div>

    <!-- MODAL ĐĂNG NHẬP / ĐĂNG KÝ -->
    <div class="modal" id="modalAuth">
        <div class="modal-content">
            <div class="modal-title-custom">Tài Khoản Sinek Store</div>
            <div class="form-group">
                <label>Tên tài khoản:</label>
                <input type="text" id="authUsername" class="form-control" placeholder="Nhập username">
            </div>
            <div class="form-group">
                <label>Mật khẩu:</label>
                <input type="password" id="authPassword" class="form-control" placeholder="Nhập mật khẩu">
            </div>
            <div class="modal-buttons">
                <button class="btn-submit" onclick="thucHienDangKy()">Đăng Ký</button>
                <button class="btn-submit" style="background:#10b981;" onclick="thucHienDangNhap()">Đăng Nhập</button>
            </div>
            <button class="btn-close" style="width:100%; margin-top:10px;" onclick="dongModal('modalAuth')">Đóng</button>
        </div>
    </div>
    <script>
        // TỰ ĐỘNG TẠO HIỆU ỨNG SAO BĂNG VÚT QUA BẦU TRỜI
        function createShootingStar() {
            const star = document.createElement('div');
            star.classList.add('shooting-star');
            
            // Vị trí xuất hiện ngẫu nhiên phía trên màn hình
            star.style.top = Math.random() * 50 + 'vh';
            star.style.left = Math.random() * 100 + 'vw';
            
            // Chiều dài vệt sao băng (từ 80px đến 150px)
            let length = Math.floor(Math.random() * 70) + 80;
            star.style.width = length + 'px';
            
            // Tốc độ bay ngẫu nhiên (từ 1.2s đến 2.5s)
            let duration = Math.random() * 1.3 + 1.2;
            star.style.animationDuration = duration + 's';
            
            document.body.appendChild(star);
            
            setTimeout(() => {
                star.remove();
            }, duration * 1000);
        }

        // Sinh sao băng ngẫu nhiên mỗi 1.8 giây
        setInterval(createShootingStar, 1800);

        function dongPopupNotice() {
            document.getElementById('popupNotice').style.display = 'none';
        }

        function moMenuLienHe() {
            document.getElementById('modalContactAdmin').style.display = 'flex';
        }

        function lienHeZalo() {
            window.location.href = "https://zalo.me/0794221549";
        }

        function lienHeFB() {
            window.location.href = "https://www.facebook.com/share/1Dy3Rqke3P/";
        }

        function chuyenTrangCTV() {
            window.location.href = "https://sinekut.github.io/ctv-sinekstore/";
        }

        const databaseSanPham = {
            caythue: [
                { id: 1, name: "Cày Level Max King Legacy", price: 50000, icon: "👑" },
                { id: 2, name: "Săn Sea King Fin", price: 16000, icon: "⚔️" },
                { id: 3, name: "Cày Beli / Thợ Săn Biển", price: 30000, icon: "💰" }
            ],
            itemnguyenlieu: [
                { id: 4, name: "Donate ĐTP King Legacy", price: 1000, icon: "💎" },
                { id: 5, name: "Kiếm Hiếm / Phụ Kiện King Legacy", price: 45000, icon: "🗡️️" },
                { id: 6, name: "Nguyên Liệu Đột Phá", price: 20000, icon: "📦" }
            ]
        };

        let currentUser = localStorage.getItem('sinek_logged_user') || null;

        window.onload = function() {
            capNhatGiaoDienUser();
        };

        function chuyenTab(tabName, element) {
            document.querySelectorAll('.page-view').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));

            if(element) element.classList.add('active');

            if(tabName === 'home') {
                document.getElementById('pageHome').style.display = 'block';
            } else if(tabName === 'deposit') {
                document.getElementById('pageDeposit').style.display = 'block';
                let syntaxUser = currentUser ? currentUser : "vãng_lai";
                document.getElementById('bankSyntaxContent').innerText = "Nội dung chuyển khoản: NAP_" + syntaxUser;
            } else if(tabName === 'history') {
                document.getElementById('pageHistory').style.display = 'block';
                hienThiLichSu();
            } else if(tabName === 'admin') {
                document.getElementById('pageAdmin').style.display = 'block';
            }
        }

        function moDanhMuc(keyDM) {
            document.getElementById('pageHome').style.display = 'none';
            document.getElementById('pageProducts').style.display = 'block';
            
            let listHTML = '';
            let danhSach = databaseSanPham[keyDM] || [];
            
            document.getElementById('categoryTitle').innerText = keyDM === 'caythue' ? 'Cày Thuê King Legacy' : 'Item & Nguyên Liệu King Legacy';

            danhSach.forEach(sp => {
                let onclickFunc = keyDM === 'caythue' ? `moModalCayThue('${sp.name}', ${sp.price})` : `moModalItem('${sp.name}', ${sp.price})`;
                listHTML += `
                    <div class="card">
                        <div class="card-icon">${sp.icon}</div>
                        <div class="card-title">${sp.name}</div>
                        <div class="card-desc" style="color: #38bdf8; font-weight: bold;">${sp.price.toLocaleString()} đ</div>
                        <button class="action-btn" onclick="${onclickFunc}">Đặt Đơn</button>
                    </div>
                `;
            });
            document.getElementById('productList').innerHTML = listHTML;
        }

        function veTrangChu() {
            document.getElementById('pageProducts').style.display = 'none';
            document.getElementById('pageHome').style.display = 'block';
        }

        function moModalAuth() {
            document.getElementById('modalAuth').style.display = 'flex';
        }
        function dongModal(id) {
            document.getElementById(id).style.display = 'none';
        }

        function thucHienDangKy() {
            let u = document.getElementById('authUsername').value.trim();
            let p = document.getElementById('authPassword').value.trim();
            if(!u || !p) { alert('Vui lòng điền đầy đủ tài khoản và mật khẩu!'); return; }
            
            if(localStorage.getItem('sinek_user_' + u)) {
                alert('Tài khoản này đã tồn tại!');
                return;
            }
            localStorage.setItem('sinek_user_' + u, p);
            localStorage.setItem('sinek_bal_' + u, '0');
            alert('Đăng ký thành công! Bạn có thể đăng nhập ngay.');
        }

        function thucHienDangNhap() {
            let u = document.getElementById('authUsername').value.trim();
            let p = document.getElementById('authPassword').value.trim();
            let savedPass = localStorage.getItem('sinek_user_' + u);
            
            if(savedPass && savedPass === p) {
                currentUser = u;
                localStorage.setItem('sinek_logged_user', u);
                alert('Đăng nhập thành công!');
                dongModal('modalAuth');
                capNhatGiaoDienUser();
            } else {
                alert('Sai tên đăng nhập hoặc mật khẩu!');
            }
        }

        function capNhatGiaoDienUser() {
            if(currentUser) {
                let bal = localStorage.getItem('sinek_bal_' + currentUser) || '0';
                document.getElementById('displayBalance').innerText = parseInt(bal).toLocaleString() + ' đ';
                let btn = document.getElementById('authBtn');
                btn.innerText = currentUser + ' (Đăng xuất)';
                btn.onclick = function() {
                    localStorage.removeItem('sinek_logged_user');
                    currentUser = null;
                    location.reload();
                };
            } else {
                document.getElementById('displayBalance').innerText = '0 đ';
                document.getElementById('authBtn').innerText = 'Đăng Nhập';
                document.getElementById('authBtn').onclick = moModalAuth;
            }
        }

        let sanphamDangChon = {};

        function moModalCayThue(ten, gia) {
            sanphamDangChon = { name: ten, price: gia };
            document.getElementById('ctProductName').value = ten;
            document.getElementById('ctProductPrice').value = gia.toLocaleString() + ' đ';
            document.getElementById('ctGameUser').value = '';
            document.getElementById('ctGamePass').value = '';
            document.getElementById('ctNote').value = '';
            document.getElementById('ctPhone').value = '';
            document.getElementById('modalCayThue').style.display = 'flex';
        }

        function moModalItem(ten, gia) {
            sanphamDangChon = { name: ten, price: gia };
            document.getElementById('itProductName').value = ten;
            document.getElementById('itProductPrice').value = gia.toLocaleString() + ' đ';
            document.getElementById('itGameUser').value = '';
            document.getElementById('itPhone').value = '';
            document.getElementById('modalItem').style.display = 'flex';
        }

        function xacNhanThanhToanCayThue() {
            let gUser = document.getElementById('ctGameUser').value.trim();
            let gPass = document.getElementById('ctGamePass').value.trim();
            let note = document.getElementById('ctNote').value.trim() || 'Không có';
            let phone = document.getElementById('ctPhone').value.trim();

            if(!gUser || !gPass || !phone) {
                alert('Vui lòng điền đầy đủ Tên acc, Mật khẩu và Số điện thoại!');
                return;
            }

            let randomCode = 'SNK-' + Math.floor(100000 + Math.random() * 900000);

            let noiDungGui = `[ĐƠN CÀY THUÊ KING LEGACY - ${randomCode}]\n- Khách hàng: ${currentUser || 'Khách vãng lai'}\n- Sản phẩm: ${sanphamDangChon.name}\n- Giá tiền: ${sanphamDangChon.price.toLocaleString()}đ\n- Tên Acc: ${gUser}\n- Mật Khẩu: ${gPass}\n- Ghi chú: ${note}\n- SĐT: ${phone}`;

            navigator.clipboard.writeText(noiDungGui).then(() => {
                alert(`Đã tạo mã đơn: ${randomCode}\nĐã sao chép sẵn thông tin! Hệ thống sẽ chuyển sang Zalo, bạn chỉ cần dán và gửi cho Admin.`);
                window.location.href = "https://zalo.me/0794221549";
            }).catch(err => {
                alert('Thông tin đơn hàng của bạn:\n\n' + noiDungGui);
            });

            dongModal('modalCayThue');
        }

        function xacNhanThanhToanItem() {
            let gUser = document.getElementById('itGameUser').value.trim();
            let phone = document.getElementById('itPhone').value.trim();

            if(!gUser || !phone) {
                alert('Vui lòng điền đầy đủ Tên đăng nhập Roblox và Số điện thoại!');
                return;
            }

            let randomCode = 'SNK-' + Math.floor(100000 + Math.random() * 900000);

            let noiDungGui = `[ĐƠN MUA ITEM / NGUYÊN LIỆU - ${randomCode}]\n- Khách hàng: ${currentUser || 'Khách vãng lai'}\n- Sản phẩm: ${sanphamDangChon.name}\n- Giá tiền: ${sanphamDangChon.price.toLocaleString()}đ\n- Tên Đăng Nhập Roblox: ${gUser}\n- SĐT: ${phone}`;

            navigator.clipboard.writeText(noiDungGui).then(() => {
                alert(`Đã tạo mã đơn: ${randomCode}\nĐã sao chép sẵn thông tin! Hệ thống sẽ chuyển sang Zalo, bạn chỉ cần dán và gửi cho Admin.`);
                window.location.href = "https://zalo.me/0794221549";
            }).catch(err => {
                alert('Thông tin đơn hàng của bạn:\n\n' + noiDungGui);
            });

            dongModal('modalItem');
        }

        function hienThiLichSu() {
            if(!currentUser) {
                document.getElementById('historyList').innerHTML = 'Vui lòng đăng nhập để xem lịch sử đơn hàng.';
                return;
            }
            let historyKey = 'sinek_history_' + currentUser;
            let listHist = JSON.parse(localStorage.getItem(historyKey) || '[]');
            if(listHist.length === 0) {
                document.getElementById('historyList').innerHTML = 'Chưa có đơn hàng nào.';
                return;
            }
            let html = '';
            listHist.forEach(h => {
                html += `
                    <div style="background:#0f172a; border:1px solid #334155; padding:10px; border-radius:8px; margin-bottom:8px; text-align:left;">
                        <b style="color:#38bdf8;">Mã đơn: ${h.code}</b><br>
                        <span>Sản phẩm: ${h.item}</span><br>
                        <span>Giá: ${h.price.toLocaleString()}đ</span><br>
                        <span style="font-size:10px; color:#94a3b8;">Thời gian: ${h.time}</span>
                    </div>
                `;
            });
            document.getElementById('historyList').innerHTML = html;
        }

        function guiTheCaoZalo() {
            let tType = document.getElementById('cardType').value;
            let tAmount = document.getElementById('cardAmount').value;
            let tSeri = document.getElementById('cardSeri').value.trim();
            let tPin = document.getElementById('cardPin').value.trim();

            if(!tSeri || !tPin) {
                alert('Vui lòng nhập đầy đủ Số Seri và Mã Thẻ!');
                return;
            }

            let noiDungGui = `[NẠP THẺ CÀO SINEK STORE]\n- Tài khoản: ${currentUser || 'Chưa đăng nhập'}\n- Loại thẻ: ${tType}\n- Mệnh giá: ${parseInt(tAmount).toLocaleString()}đ\n- Số Seri: ${tSeri}\n- Mã Thẻ: ${tPin}`;

            navigator.clipboard.writeText(noiDungGui).then(() => {
                alert('Đã sao chép thông tin thẻ! Hệ thống sẽ chuyển sang Zalo.');
                window.location.href = "https://zalo.me/0794221549";
            }).catch(err => {
                alert('Thông tin thẻ:\n\n' + noiDungGui);
            });
        }

        function guiTheCaoFB() {
            let tType = document.getElementById('cardType').value;
            let tAmount = document.getElementById('cardAmount').value;
            let tSeri = document.getElementById('cardSeri').value.trim();
            let tPin = document.getElementById('cardPin').value.trim();

            if(!tSeri || !tPin) {
                alert('Vui lòng nhập đầy đủ Số Seri và Mã Thẻ!');
                return;
            }

            let noiDungGui = `[NẠP THẺ CÀO SINEK STORE]\n- Tài khoản: ${currentUser || 'Chưa đăng nhập'}\n- Loại thẻ: ${tType}\n- Mệnh giá: ${parseInt(tAmount).toLocaleString()}đ\n- Số Seri: ${tSeri}\n- Mã Thẻ: ${tPin}`;

            navigator.clipboard.writeText(noiDungGui).then(() => {
                alert('Đã sao chép thông tin thẻ! Hệ thống sẽ chuyển sang Facebook của Admin.');
                window.location.href = "https://www.facebook.com/share/1Dy3Rqke3P/";
            }).catch(err => {
                alert('Thông tin thẻ:\n\n' + noiDungGui);
            });
        }

        function kiemTraAdmin() {
            let pass = document.getElementById('adminPassInput').value;
            if(pass === 'sinekadmin123') {
                document.getElementById('adminLoginBox').style.display = 'none';
                document.getElementById('adminPanelBox').style.display = 'block';
                alert('Đăng nhập Quản Trị Viên thành công!');
            } else {
                alert('Sai mật khẩu quản trị viên!');
            }
        }

        function adminNapTien() {
            let targetUser = document.getElementById('adUserTarget').value.trim();
            let amount = parseInt(document.getElementById('adAmountTarget').value);

            if(!targetUser || isNaN(amount)) {
                alert('Vui lòng nhập đúng tên tài khoản khách và số tiền cần nạp!');
                return;
            }

            let currentBal = localStorage.getItem('sinek_bal_' + targetUser);
            if(currentBal === null) {
                alert('Tên tài khoản khách hàng không tồn tại trên hệ thống!');
                return;
            }

            let newBal = parseInt(currentBal) + amount;
            localStorage.setItem('sinek_bal_' + targetUser, newBal);
            
            if(currentUser === targetUser) {
                capNhatGiaoDienUser();
            }

            alert(`Đã nạp thành công ${amount.toLocaleString()}đ cho tài khoản: ${targetUser}\nSố dư mới: ${newBal.toLocaleString()}đ`);
            document.getElementById('adUserTarget').value = '';
            document.getElementById('adAmountTarget').value = '';
        }
    </script>
</body>
</html>